{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure",
      "type": "shell",
      "command": "cmake --preset debug",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "build",
      "type": "shell",
      "command": "cmake --build build/debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "cmake --build build/debug --target clean",
      "problemMatcher": []
    },
    {
      "label": "flash",
      "type": "shell",
      "command": "openocd -f openocd.cfg -c \"program build/debug/h743_cmsis_dap.elf verify reset exit\"",
      "dependsOn": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
