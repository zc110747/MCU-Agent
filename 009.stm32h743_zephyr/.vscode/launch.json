{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (OpenOCD + ST-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/zephyr/zephyr.elf",
            "serverpath": "openocd.exe",
            "configFiles": [
                "${workspaceFolder}/tools/openocd.cfg"
            ],
            "gdbPath": "arm-none-eabi-gdb",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "preLaunchTask": "build",
            "interface": "swd",
            "device": "STM32H743ZI",
            "clockSpeed": 4000,
            "rtos": "Zephyr"
        },
        {
            "name": "Flash & Debug",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/zephyr/zephyr.elf",
            "serverpath": "openocd.exe",
            "configFiles": [
                "${workspaceFolder}/tools/openocd.cfg"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "gdbPath": "arm-none-eabi-gdb",
            "preLaunchTask": "build",
            "interface": "swd",
            "device": "STM32H743ZI",
            "clockSpeed": 4000,
            "rtos": "Zephyr"
        }
    ]
}
