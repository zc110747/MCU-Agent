  "buildPresets": [
    { "name": "debug",   "configurePreset": "debug",   "targets": ["stm32f429_ui_music.elf"] },
    { "name": "release", "configurePreset": "release", "targets": ["stm32f429_ui_music.elf"] }
  ]
}
