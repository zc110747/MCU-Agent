{
    "version": 4,
    "configurations": [
        {
            "name": "STM32H743 (arm-none-eabi)",
            // CMake writes compile_commands.json, so IntelliSense sees exactly
            // the flags the compiler sees - no hand maintained include list.
            "compileCommands": "${workspaceFolder}/build/debug/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/Core/Inc",
                "${workspaceFolder}/bsp",
                "${workspaceFolder}/app",
                "${workspaceFolder}/middleware/face_detect",
                "${workspaceFolder}/Drivers/STM32H7xx_HAL_Driver/Inc",
                "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32H7xx/Include",
                "${workspaceFolder}/Drivers/CMSIS/Core/Include",
                "${workspaceFolder}/Drivers/CMSIS/DSP/Include",
                "${workspaceFolder}/Drivers/CMSIS/NN/Include"
            ],
            "defines": [
                "USE_HAL_DRIVER",
                "STM32H743xx",
                "ARM_MATH_CM7",
                "__FPU_PRESENT=1U"
            ],
            "cStandard": "c11",
            "intelliSenseMode": "gcc-arm"
        }
    ]
}
