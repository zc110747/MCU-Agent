diff --git a/src/portable/synopsys/dwc2/dwc2_stm32.h b/src/portable/synopsys/dwc2/dwc2_stm32.h
index 0c9b534..b387bff 100644
--- a/src/portable/synopsys/dwc2/dwc2_stm32.h
+++ b/src/portable/synopsys/dwc2/dwc2_stm32.h
@@ -37,8 +37,6 @@ extern "C" {
 
 #elif CFG_TUSB_MCU == OPT_MCU_STM32H7
   #include "stm32h7xx.h"
-  #define EP_MAX_FS       9
-  #define DFIFO_DEPTH_FS 1024
 
   #define EP_MAX_HS       9
   #define DFIFO_DEPTH_HS 1024
@@ -48,6 +46,30 @@ extern "C" {
   #if (! defined USB2_OTG_FS)
     #define USB_OTG_FS_PERIPH_BASE  USB1_OTG_HS_PERIPH_BASE
     #define OTG_FS_IRQn             OTG_HS_IRQn
+
+    // Single-port H7: "FS" is really the OTG_HS core (4 KB SPRAM, 9 endpoints)
+    #define EP_MAX_FS       9
+    #define DFIFO_DEPTH_FS 1024
+  #else
+    // ---------------------------------------------------------------------
+    // LOCAL PATCH (see patches/0001-dwc2-stm32h7-fs-fifo-depth.patch)
+    //
+    // Dual-port H7 (H742/H743/H745/H747/H750/H753/H755/H757): rhport 0 is the
+    // *separate* USB2_OTG_FS core, which only has 1.25 KB of dedicated SPRAM
+    // (320 x 32-bit words) - not the 4 KB of the OTG_HS core.
+    //
+    // Cross-checked against ST's own STM32H743I-EVAL USB device example:
+    //     HAL_PCDEx_SetRxFiFo(&hpcd_FS, 0x80);       // 128 words
+    //     HAL_PCDEx_SetTxFiFo(&hpcd_FS, 0, 0x40);    //  64 words
+    //     HAL_PCDEx_SetTxFiFo(&hpcd_FS, 1, 0x80);    // 128 words
+    //                                        total  = 320 words = 1.25 KB
+    //
+    // Leaving this at 1024 makes dfifo_alloc() hand out FIFO offsets beyond
+    // the physical SPRAM (it allocates downwards from the top), which silently
+    // corrupts every transfer - the device never enumerates.
+    // ---------------------------------------------------------------------
+    #define EP_MAX_FS       9
+    #define DFIFO_DEPTH_FS  320
   #endif
 
 #elif CFG_TUSB_MCU == OPT_MCU_STM32H7RS
