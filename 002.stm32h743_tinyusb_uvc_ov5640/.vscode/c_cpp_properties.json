{
  "version": 4,
  "configurations": [
    {
      "name": "STM32H743 (arm-none-eabi)",
      "compilerPath": "arm-none-eabi-gcc.exe",
      "compilerArgs": ["-mcpu=cortex-m7", "-mthumb", "-mfpu=fpv5-d16", "-mfloat-abi=hard"],
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "gcc-arm",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/Core/Inc",
        "${workspaceFolder}/BSP/ov5640",
        "${workspaceFolder}/Drivers/STM32H7xx_HAL_Driver/Inc",
        "${workspaceFolder}/Drivers/STM32H7xx_HAL_Driver/Inc/Legacy",
        "${workspaceFolder}/Drivers/CMSIS/Include",
        "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32H7xx/Include",
        "${workspaceFolder}/third_party/tinyusb/src"
      ],
      "defines": [
        "USE_HAL_DRIVER",
        "STM32H743xx",
        "HSE_VALUE=25000000",
        "CFG_TUSB_MCU=OPT_MCU_STM32H7",
        "CFG_TUSB_OS=OPT_OS_NONE",
        "BOARD_TUD_RHPORT=0",
        "BOARD_TUD_MAX_SPEED=OPT_MODE_FULL_SPEED"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/Core",
          "${workspaceFolder}/BSP",
          "${workspaceFolder}/Drivers",
          "${workspaceFolder}/third_party/tinyusb/src"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
