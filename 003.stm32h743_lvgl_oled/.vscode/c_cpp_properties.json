{
    "version": 4,
    "configurations": [
        {
            "name": "STM32H743 (arm-none-eabi)",
            // IntelliSense reads the real include paths / defines straight from
            // the CMake-generated database, so this file needs no absolute paths.
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "cStandard": "c11",
            "intelliSenseMode": "gcc-arm",
            "defines": [
                "STM32H743xx",
                "USE_HAL_DRIVER"
            ]
        }
    ]
}
