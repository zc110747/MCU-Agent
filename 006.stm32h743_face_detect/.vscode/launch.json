{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (OpenOCD + ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/debug/stm32h7_face_detect.elf",
      "configFiles": [
        "${workspaceFolder}/openocd.cfg"
      ],
      "openocdPath": "openocd",
      "gdbPath": "arm-none-eabi-gdb",
      "device": "STM32H743ZI",
      "interface": "swd",
      "runToEntryPoint": "main",
      "preLaunchTask": "build",
      "showDevDebugOutput": "none",
      "svdFile": "${workspaceFolder}/STM32H743.svd"
    },
    {
      "name": "Attach (no reflash)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/debug/stm32h7_face_detect.elf",
      "configFiles": [
        "${workspaceFolder}/openocd.cfg"
      ],
      "openocdPath": "openocd",
      "gdbPath": "arm-none-eabi-gdb",
      "device": "STM32H743ZI",
      "interface": "swd",
      "showDevDebugOutput": "none",
      "svdFile": "${workspaceFolder}/STM32H743.svd"
    }
  ]
}
