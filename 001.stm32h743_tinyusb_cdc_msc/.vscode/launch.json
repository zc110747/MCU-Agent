{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (OpenOCD + ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/stm32h743_uvc.elf",
      "servertype": "openocd",
      "configFiles": ["${workspaceFolder}/debug/openocd.cfg"],
      "gdbPath": "D:/Software/tools/arm-none-eabi/bin/arm-none-eabi-gdb.exe",
      "device": "STM32H743ZI",
      "svdFile": "${workspaceFolder}/debug/STM32H743.svd",
      "preLaunchTask": "Build",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "none",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      },
      "postLaunchCommands": [
        "monitor arm semihosting disable"
      ],
      "//": "Handy expressions to drop into the WATCH panel:",
      "//watch": [
        "g_boot_stage", "g_loop_count", "g_fault_id",
        "g_cam_status", "g_cam_id",
        "cam_frame_count", "cam_error_count",
        "cam_start_count", "cam_start_fail_count",
        "usb_mounted", "usb_mount_count", "usb_commit_count",
        "uvc_frames_sent", "uvc_frames_dropped"
      ]
    },
    {
      "name": "Attach (no flash)",
      "type": "cortex-debug",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/stm32h743_uvc.elf",
      "servertype": "openocd",
      "serverpath": "D:/Software/openocd/bin/openocd.exe",
      "searchDir": ["D:/Software/openocd/share/openocd/scripts"],
      "configFiles": ["${workspaceFolder}/debug/openocd.cfg"],
      "gdbPath": "D:/Software/tools/arm-none-eabi/bin/arm-none-eabi-gdb.exe",
      "device": "STM32H743ZI",
      "svdFile": "${workspaceFolder}/debug/STM32H743.svd",
      "showDevDebugOutput": "none",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      }
    }
  ]
}
