{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (OpenOCD + ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/debug/h743_tinyusb_cdc.elf",
      "servertype": "openocd",
      "configFiles": ["${workspaceFolder}/openocd/stm32h743_stlink.cfg"],
      "device": "STM32H743ZI",
      "svdFile": "${workspaceFolder}/.vscode/STM32H743.svd",
      "interface": "swd",
      "runToEntryPoint": "main",
      "preLaunchTask": "build debug",
      "showDevDebugOutput": "none",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      },
      "postLaunchCommands": [
        "monitor arm semihosting disable"
      ]
    },
    {
      "name": "Attach (already running)",
      "type": "cortex-debug",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/debug/h743_tinyusb_cdc.elf",
      "servertype": "openocd",
      "configFiles": ["${workspaceFolder}/openocd/stm32h743_stlink.cfg"],
      "device": "STM32H743ZI",
      "svdFile": "${workspaceFolder}/.vscode/STM32H743.svd",
      "interface": "swd",
      "showDevDebugOutput": "none"
    }
  ]
}
