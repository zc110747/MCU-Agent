{
  "cmake.configureOnOpen": false,
  "cmake.useCMakePresets": "always",
  "cortex-debug.variableUseNaturalFormat": false,
  "files.associations": {
    "*.ld": "linkerscript",
    "tusb_config.h": "c",
    "stm32h7xx_hal_conf.h": "c"
  },
  "files.exclude": {
    "build/": true
  },
  "search.exclude": {
    "build/": true,
    "lib/": true
  },
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/debug/compile_commands.json"
}
