{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build",
        "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "-j"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Rebuild",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--clean-first", "-j"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--target", "clean"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Flash",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f", "${workspaceFolder}/debug/openocd.cfg",
        "-c", "program ${workspaceFolder}/build/stm32h743_uvc.elf verify reset exit"
      ],
      "dependsOn": "Build",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Erase chip",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f", "${workspaceFolder}/debug/openocd.cfg",
        "-c", "init; reset halt; stm32h7x mass_erase 0; stm32h7x mass_erase 1; reset; exit"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "OpenOCD server",
      "type": "shell",
      "command": "openocd",
      "args": ["-f", "${workspaceFolder}/debug/openocd.cfg"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Open On-Chip Debugger",
          "endsPattern": "Listening on port \\d+ for gdb connections"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Show size",
      "type": "shell",
      "command": "arm-none-eabi-size",
      "args": ["-A", "-x", "${workspaceFolder}/build/stm32h743_uvc.elf"],
      "problemMatcher": []
    }
  ]
}
