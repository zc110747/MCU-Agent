# 32 KB RAM for the board-init / main thread
CONFIG_MAIN_STACK_SIZE=4096

# Enable MPU and hardware stack protection (Cortex-M4)
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# Serial console
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# GPIO + pin control
CONFIG_GPIO=y
CONFIG_CLOCK_CONTROL=y
CONFIG_PINCTRL=y
